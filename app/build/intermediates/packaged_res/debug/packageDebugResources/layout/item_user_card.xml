<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_form_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <FrameLayout
        android:id="@+id/flAvatarContainer"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:background="@drawable/bg_avatar_student">

        <TextView
            android:id="@+id/tvUserInitial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="S"
            android:textColor="@color/status_moving"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDriverNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="1dp"
            android:textColor="@color/text_secondary"
            android:textSize="7sp"
            android:visibility="gone"
            android:text="01" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvUserName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="User Name"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvUserEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="user@upsi.edu.my"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvUserRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_role_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="STUDENT"
                android:textColor="@color/crimson_primary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAccountType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_portal_badge"
                android:paddingHorizontal="6dp"
                android:paddingVertical="3dp"
                android:text="PORTAL"
                android:textColor="@color/amber_accent"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvAssignedRoute"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text=""
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

    <ImageButton
        android:id="@+id/btnEditUser"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_icon_btn_edit"
        android:contentDescription="Edit"
        android:padding="8dp"
        android:src="@android:drawable/ic_menu_edit"
        app:tint="@color/crimson_primary" />

    <ImageButton
        android:id="@+id/btnDeleteUser"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_icon_btn_delete"
        android:contentDescription="Delete"
        android:padding="8dp"
        android:src="@android:drawable/ic_menu_delete"
        app:tint="@color/signout_text" />

</LinearLayout>
