<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Main row: avatar + info + actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <!-- Avatar with driver number badge -->
            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="52dp">

                <!-- Coloured circle -->
                <FrameLayout
                    android:id="@+id/flAvatarContainer"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_avatar_student">

                    <TextView
                        android:id="@+id/tvUserInitial"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="S"
                        android:textColor="@color/text_white"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </FrameLayout>

                <!-- Driver number badge (bottom-right corner) -->
                <TextView
                    android:id="@+id/tvDriverNumber"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_role_badge"
                    android:gravity="center"
                    android:textColor="@color/crimson_primary"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    android:text="01" />

            </FrameLayout>

            <!-- User info -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="User Name"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvUserEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="user@upsi.edu.my"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <!-- Badges row -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvUserRole"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_role_badge"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="STUDENT"
                        android:textColor="@color/crimson_primary"
                        android:textSize="10sp"
                        android:letterSpacing="0.05"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAccountType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_portal_badge"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="3dp"
                        android:text="PORTAL"
                        android:textColor="@color/amber_accent"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- Assigned route / faculty info -->
                <TextView
                    android:id="@+id/tvAssignedRoute"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_filter_chip"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Action buttons (stacked vertically for safer tap targets) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnEditUser"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_icon_btn_edit"
                    android:contentDescription="Edit"
                    android:padding="9dp"
                    android:src="@drawable/ic_edit" />

                <ImageButton
                    android:id="@+id/btnDeleteUser"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_icon_btn_delete"
                    android:contentDescription="Delete"
                    android:padding="9dp"
                    android:src="@drawable/ic_delete" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
