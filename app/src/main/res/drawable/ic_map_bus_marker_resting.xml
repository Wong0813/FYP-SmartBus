<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer pulse glow ring (amber) -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#40FF9800" />
            <size android:width="32dp" android:height="32dp" />
        </shape>
    </item>
    <!-- Inner solid amber core with white border -->
    <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp">
        <shape android:shape="oval">
            <solid android:color="#F57C00" />
            <stroke android:width="2dp" android:color="#FFFFFF" />
            <size android:width="22dp" android:height="22dp" />
        </shape>
    </item>
</layer-list>
