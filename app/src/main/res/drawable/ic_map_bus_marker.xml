<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer pulse glow ring -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#40B71C1C" />
            <size android:width="36dp" android:height="36dp" />
        </shape>
    </item>
    <!-- Middle ring -->
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="oval">
            <solid android:color="#80B71C1C" />
            <size android:width="28dp" android:height="28dp" />
        </shape>
    </item>
    <!-- Inner solid crimson core with crisp white border -->
    <item android:left="7dp" android:top="7dp" android:right="7dp" android:bottom="7dp">
        <shape android:shape="oval">
            <solid android:color="#B71C1C" />
            <stroke android:width="2.5dp" android:color="#FFFFFF" />
            <size android:width="22dp" android:height="22dp" />
        </shape>
    </item>
</layer-list>
