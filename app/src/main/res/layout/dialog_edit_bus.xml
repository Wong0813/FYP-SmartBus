<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- ══════════ HEADER ══════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvEditBusDialogTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Edit Bus Details"
                android:textColor="#111827"
                android:textSize="17.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Update fleet vehicle info and route assignment"
                android:textColor="#9CA3AF"
                android:textSize="11.5sp" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/btnDialogBusClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_icon_btn_edit"
            android:contentDescription="Close"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_close"
            app:tint="#6B7280" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="14dp"
        android:background="#F1F5F9" />

    <!-- ══════════ BUS PHOTO PREVIEW ZONE ══════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="14dp"
        android:background="#F8FAFC"
        android:padding="12dp">

        <androidx.cardview.widget.CardView
            android:layout_width="80dp"
            android:layout_height="56dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardPreventCornerOverlap="true">

            <ImageView
                android:id="@+id/ivDialogBusThumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Bus Image"
                android:scaleType="centerCrop"
                android:background="#F1F5F9"
                android:src="@drawable/ic_bus_white" />

        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Campus Transit Bus"
                android:textColor="#1F2937"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Upload custom bus photo to Firebase"
                android:textColor="#9CA3AF"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/btnPickBusPhoto"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_btn_sync_white"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="📷 Change Photo"
                android:textColor="#1F2937"
                android:textSize="11.5sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <!-- ══════════ INPUT FIELDS ══════════ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="320dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Field 1: Bus Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="BUS NAME / LABEL"
                android:textColor="#6B7280"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etEditBusName"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_input_field"
                android:hint="e.g. Bas Kampus Utama"
                android:importantForAutofill="no"
                android:inputType="text"
                android:paddingHorizontal="14dp"
                android:textColor="@color/text_primary"
                android:textSize="13.5sp" />

            <!-- Field 2: License Plate -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="LICENSE PLATE"
                android:textColor="#6B7280"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etEditBusPlate"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_input_field"
                android:hint="e.g. WAA 1234 A"
                android:importantForAutofill="no"
                android:inputType="text"
                android:paddingHorizontal="14dp"
                android:textColor="@color/text_primary"
                android:textSize="13.5sp" />

            <!-- Field 3: Assigned Route -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="ASSIGNED ROUTE"
                android:textColor="#6B7280"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerEditBusRoute"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="12dp" />

        </LinearLayout>

    </ScrollView>

    <!-- ══════════ ACTION BUTTONS ══════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnDialogBusCancel"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_sync_white"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="Cancel"
            android:textColor="#4B5563"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnDialogBusSave"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1.3"
            android:background="@drawable/bg_btn_new_account"
            android:clickable="true"
            android:elevation="2dp"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="Save Changes"
            android:textColor="@color/text_white"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
