<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:orientation="vertical">

    <!-- ══════════ HERO ZONE (Deep Crimson Gradient) ══════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_account_hero_gradient"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="36dp"
        android:paddingBottom="24dp">

        <!-- Hero Top Bar (Integrated Hamburger & STUDENT Badge) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnHeroDrawer"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_hero_drawer_btn"
                android:contentDescription="Open Menu"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_menu_burger"
                app:tint="@color/text_white" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero_admin_badge"
                android:letterSpacing="0.1"
                android:paddingHorizontal="14dp"
                android:paddingVertical="5dp"
                android:text="STUDENT"
                android:textColor="@color/text_white"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Subtitle Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.15"
            android:text="OFFICIAL TIMETABLES"
            android:textColor="#FECACA"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Route Schedules"
            android:textColor="@color/text_white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Check regular and weekend campus departure times"
            android:textColor="#FECACA"
            android:textSize="11.5sp" />

    </LinearLayout>

    <!-- Modern Tabs -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        style="@style/SmartBus.TabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_bg"
        android:elevation="2dp"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/crimson_primary"
        app:tabMode="fixed"
        app:tabSelectedTextColor="@color/crimson_primary"
        app:tabTextColor="@color/text_secondary" />

    <!-- ViewPager2 for schedule tabs -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
