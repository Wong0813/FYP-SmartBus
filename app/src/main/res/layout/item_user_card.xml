<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:cardPreventCornerOverlap="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp">

        <!-- Avatar Rounded Box (AI Human Face) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardAvatarContainer"
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardPreventCornerOverlap="true">

            <ImageView
                android:id="@+id/ivUserAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="User avatar"
                android:scaleType="centerCrop"
                tools:src="@drawable/avatar_admin_1" />

            <TextView
                android:id="@+id/tvUserInitial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="@color/text_white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="R" />

        </androidx.cardview.widget.CardView>

        <!-- User Info Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="#111827"
                android:textSize="13.5sp"
                android:textStyle="bold"
                tools:text="Encik Razif Bin Hassan" />

            <TextView
                android:id="@+id/tvUserEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="#9CA3AF"
                android:textSize="10.5sp"
                tools:text="driver1@upsi.edu.my · DRV-01" />

            <!-- Badges & Meta Row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvUserRole"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_role_badge"
                    android:letterSpacing="0.06"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="2dp"
                    android:text="DRIVER"
                    android:textColor="@color/crimson_primary"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAssignedRoute"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="#9CA3AF"
                    android:textSize="10sp"
                    android:visibility="gone"
                    tools:text="Laluan 1 · BUS-001" />

            </LinearLayout>

        </LinearLayout>

        <!-- Vertical Action Buttons (Edit & Delete) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnEditUser"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_icon_btn_edit"
                android:contentDescription="Edit User"
                android:padding="7dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_edit"
                app:tint="#9CA3AF" />

            <ImageButton
                android:id="@+id/btnDeleteUser"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_icon_btn_delete"
                android:contentDescription="Delete User"
                android:padding="7dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_delete"
                app:tint="#EF4444" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
