<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="90dp"
    android:orientation="horizontal">

    <!-- Left accent strip (color set programmatically) -->
    <View
        android:id="@+id/accentStrip"
        android:layout_width="5dp"
        android:layout_height="match_parent"
        android:background="@color/status_moving" />

    <!-- Content area -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Bus name -->
        <TextView
            android:id="@+id/tvBusName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Bus A" />

        <!-- Route description -->
        <TextView
            android:id="@+id/tvRoute"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            tools:text="Laluan 1 • KAB ➔ PT ➔ SS ➔ KA ➔ DKP ➔ KAB" />

        <!-- Bottom row: start badge + next stop -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Start badge -->
            <TextView
                android:id="@+id/tvStartStop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_offline"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                tools:text="Start: KAB" />

            <!-- Next stop indicator -->
            <TextView
                android:id="@+id/tvNextStop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                tools:text="📍 Next: KUO" />
        </LinearLayout>
    </LinearLayout>

    <!-- Trailing AI ETA widget -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_eta_ai_capsule"
        android:gravity="center"
        android:minWidth="70dp"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ai_eta"
            android:textColor="@color/text_secondary"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/tvAiEta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/crimson_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="3m" />
    </LinearLayout>

</LinearLayout>
