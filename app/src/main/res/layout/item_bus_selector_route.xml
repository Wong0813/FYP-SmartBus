<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardRouteItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    android:layout_marginHorizontal="2dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="14dp"
    app:cardElevation="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp">

        <!-- Short Name Badge (e.g. L1, L2, SC, ★) -->
        <FrameLayout
            android:id="@+id/flBadgeContainer"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_crimson">

            <TextView
                android:id="@+id/tvShortName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="@color/text_white"
                android:textSize="12.5sp"
                android:textStyle="bold"
                tools:text="L1" />

        </FrameLayout>

        <!-- Route Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvRouteName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="13.5sp"
                android:textStyle="bold"
                tools:text="Laluan 1" />

            <TextView
                android:id="@+id/tvStopChain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/text_secondary"
                android:textSize="10.5sp"
                tools:text="KAB → PT → SS → KA → DKP → KAB" />

        </LinearLayout>

        <!-- Status Tag / Live Pill -->
        <LinearLayout
            android:id="@+id/llLivePill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_moving"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="7dp"
            android:paddingVertical="3dp"
            android:visibility="gone"
            tools:visibility="visible">

            <View
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:background="@drawable/dot_green" />

            <TextView
                android:id="@+id/tvLiveStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="LIVE"
                android:textColor="@color/status_moving"
                android:textSize="9.5sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Selected Checkmark Icon -->
        <ImageView
            android:id="@+id/ivSelectedCheck"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/ic_status_active"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
