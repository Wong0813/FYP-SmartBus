<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartBus"
        tools:targetApi="31">

        <!-- Google Maps API Key -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyDRVwaZBYeb9Fe7jcNQpVORBTCfWLxxylc" />

        <activity
            android:name="com.upsi.smartbus.feature.auth.LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.SmartBus.Login">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name="com.upsi.smartbus.feature.MainActivity" android:exported="false" />
        <activity android:name="com.upsi.smartbus.feature.student.StudentActivity" android:exported="false" />
        <activity android:name="com.upsi.smartbus.feature.driver.DriverActivity" android:exported="false" />
        <activity android:name="com.upsi.smartbus.feature.admin.AdminActivity" android:exported="false" />
        <activity android:name="com.upsi.smartbus.feature.student.buses.BusDetailActivity" android:exported="false" />
        <activity android:name="com.upsi.smartbus.feature.profile.ProfileActivity" android:exported="false" />

        <service android:name="com.upsi.smartbus.core.service.GpsTrackingService" android:exported="false" />

    </application>
</manifest>