rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && userDoc().role in ['ADMIN', 'admin'];
    }

    function isDriver() {
      return isSignedIn() && userDoc().role in ['DRIVER', 'driver'];
    }

    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (isAdmin() || request.auth.uid == userId);
    }

    match /buses/{busId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && (isAdmin() || isDriver());
    }

    match /routes/{routeId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isAdmin();
    }

    match /stops/{stopId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isAdmin();
    }

    match /ai_history/{historyId} {
      allow read, create: if isSignedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
